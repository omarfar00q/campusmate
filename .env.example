# ==========================================
# CampusMate Environment Configuration
# ==========================================

# Time & Timezone Configuration
CAMPUSMATE_TZ=UTC
# Optional frozen-clock override for deterministic tests & demo scenarios (ISO 8601 string)
# Example: 2026-10-12T09:00:00Z
CAMPUSMATE_NOW=

# Database Configuration
DATABASE_URL=sqlite:///./campusmate.db

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Agent Configuration (MCP Client & LLM)
# Configurable providers: openai, anthropic, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Demo Student Tokens (mapped to fictional student profiles)
DEMO_STUDENT_TOKEN_ALICE=token-alice-demo-cs
DEMO_STUDENT_TOKEN_BOB=token-bob-demo-ee
DEMO_STUDENT_TOKEN_CHARLIE=token-charlie-demo-me
